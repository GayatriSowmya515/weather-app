<%-include("partials/header")%>
<div class="app app--search">

  <div class="S1">
    <div class="S1-head">
      <h1>Weather App</h1>
    </div>

    <% if (error) { %>
    <p class="app-message app-message--error"><%= error %></p>
    <% } %>

    <button type="button" class="S1-location-btn" data-use-location>
      Use my location
    </button>

    <form action="/results" method="POST" class="S1-search">
      <input type="text" name="city" autocomplete="off" class="S1-search-box" placeholder="Search for a city" />
      <button class="S1-search-btn" type="submit">Search</button>
    </form>
  </div>

</div>

<%-include("partials/geolocation")%>
<%-include("partials/footer")%>
