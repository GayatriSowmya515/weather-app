<script>
  (function () {
    function postToResults(fields) {
      var form = document.createElement('form');
      form.method = 'POST';
      form.action = '/results';

      Object.keys(fields).forEach(function (name) {
        var input = document.createElement('input');
        input.type = 'hidden';
        input.name = name;
        input.value = fields[name];
        form.appendChild(input);
      });

      document.body.appendChild(form);
      form.submit();
    }

    function useMyLocation() {
      if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
      }

      var buttons = document.querySelectorAll('[data-use-location]');
      buttons.forEach(function (btn) {
        btn.disabled = true;
        btn.textContent = 'Getting location…';
      });

      navigator.geolocation.getCurrentPosition(
        function (position) {
          postToResults({
            lat: position.coords.latitude,
            lon: position.coords.longitude,
          });
        },
        function () {
          buttons.forEach(function (btn) {
            btn.disabled = false;
            btn.textContent = 'Use my location';
          });
          alert('Unable to get your location. Please allow location access or search by city.');
        }
      );
    }

    document.querySelectorAll('[data-use-location]').forEach(function (btn) {
      btn.addEventListener('click', useMyLocation);
    });
  })();
</script>
